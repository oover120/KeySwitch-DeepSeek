<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KeySwitch.App</RootNamespace>
    <AssemblyName>KeySwitchDeepSeek</AssemblyName>
    <AssemblyTitle>KeySwitch DeepSeek</AssemblyTitle>
    <Description>Автоматический переключатель раскладки клавиатуры RU↔EN для Windows 11</Description>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\keyswitch.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Сжатие бандла отключено осознанно: при EnableCompressionInSingleFile=true
         рантайм держит распакованные сборки в памяти, и рабочий набор процесса
         вырастает примерно на 120 МБ (281 МБ против 158 МБ при простое). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeySwitch.Core\KeySwitch.Core.csproj" />
    <ProjectReference Include="..\KeySwitch.Data\KeySwitch.Data.csproj" />
    <ProjectReference Include="..\KeySwitch.Hooks\KeySwitch.Hooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
