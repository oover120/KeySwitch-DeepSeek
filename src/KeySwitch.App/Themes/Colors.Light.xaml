<!--
    Светлая тема KeySwitch. Только цветовые ресурсы — никаких стилей,
    чтобы ThemeManager мог подменять весь словарь одним махом.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Базовые поверхности -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#E2E2E2" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="TitleBarCloseGlyphBrush" Color="#1B1B1B" />

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Акцент (значения — запасные; ThemeManager переопределяет системным акцентом) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3183CA" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E5F0FA" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#0067C0" />

    <!-- Поля ввода и кнопки -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="ControlBorderFocusBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="ButtonFillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonFillHoverBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ButtonFillPressedBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D6D6D6" />

    <!-- Прочее -->
    <SolidColorBrush x:Key="DividerBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#E5F0FA" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="ScrollerThumbBrush" Color="#C4C4C4" />
    <SolidColorBrush x:Key="ScrollerThumbHoverBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ToggleOffHoverBrush" Color="#C6C6C6" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B32B22" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="TooltipBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#FFFFFF" />

    <!-- Типографика и геометрия -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="AppFontFamilyDisplay">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>
    <sys:Double x:Key="HeaderFontSize">20</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
</ResourceDictionary>
