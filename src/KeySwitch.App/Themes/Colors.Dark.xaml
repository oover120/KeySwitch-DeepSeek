<!--
    Тёмная тема KeySwitch. Только цветовые ресурсы — набор ключей обязан
    совпадать с Colors.Light.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Базовые поверхности -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#313131" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#373737" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#202020" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="TitleBarCloseGlyphBrush" Color="#F2F2F2" />

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Акцент (значения — запасные; ThemeManager переопределяет системным акцентом) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#64CBFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3AA9E0" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F3A4A" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#4CC2FF" />

    <!-- Поля ввода и кнопки -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#292929" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#606060" />
    <SolidColorBrush x:Key="ControlBorderFocusBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="ButtonFillBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ButtonFillHoverBrush" Color="#353535" />
    <SolidColorBrush x:Key="ButtonFillPressedBrush" Color="#292929" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4A4A4A" />

    <!-- Прочее -->
    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#1F3A4A" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="ScrollerThumbBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollerThumbHoverBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ToggleOffHoverBrush" Color="#5E5E5E" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B5E" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8A7E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="TooltipBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#1B1B1B" />

    <!-- Типографика и геометрия -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="AppFontFamilyDisplay">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>
    <sys:Double x:Key="HeaderFontSize">20</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
</ResourceDictionary>
