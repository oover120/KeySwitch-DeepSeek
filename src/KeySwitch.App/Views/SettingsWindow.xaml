<Window x:Class="KeySwitch.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:KeySwitch.App.Views.Tabs"
        Title="KeySwitch — настройки"
        Width="860" Height="640"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- ===================== Заголовок окна ===================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="KS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KeySwitch — настройки"
                                   Style="{DynamicResource TitleTextStyle}"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Style="{DynamicResource TitleBarCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="OnCloseClick"
                            ToolTip="Закрыть" />
                </Grid>
            </Border>

            <!-- ===================== Вкладки ===================== -->
            <TabControl Grid.Row="1" x:Name="Tabs">
                <TabItem Header="Общие">
                    <tabs:GeneralTab />
                </TabItem>
                <TabItem Header="Исключения">
                    <tabs:ExceptionsTab />
                </TabItem>
                <TabItem Header="Опечатки">
                    <tabs:TyposTab />
                </TabItem>
                <TabItem Header="Звуки">
                    <tabs:SoundsTab />
                </TabItem>
                <TabItem Header="О программе">
                    <tabs:AboutTab />
                </TabItem>
            </TabControl>

            <!-- ===================== Нижняя панель ===================== -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Style="{DynamicResource DangerTextStyle}"
                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{DynamicResource HintTextStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Отмена"
                                MinWidth="96"
                                Margin="0,0,8,0"
                                Click="OnCancelClick" />
                        <Button Content="Сохранить"
                                MinWidth="110"
                                Style="{DynamicResource AccentButtonStyle}"
                                Click="OnSaveClick"
                                IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
