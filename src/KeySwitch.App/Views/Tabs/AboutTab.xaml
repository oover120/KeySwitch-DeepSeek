<UserControl x:Class="KeySwitch.App.Views.Tabs.AboutTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KeySwitch.App.Localization"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="14"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel MaxWidth="760"
                    Margin="26,18,26,24"
                    HorizontalAlignment="Center">

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="10"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding [app.badge], Source={x:Static loc:Loc.Instance}}"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       FontFamily="{DynamicResource AppFontFamilyDisplay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [app.name], Source={x:Static loc:Loc.Instance}}"
                                       Style="{DynamicResource TitleTextStyle}" />
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Text="{Binding AboutVersionText}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{DynamicResource DividerStyle}" Margin="0,16,0,12" />

                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{Binding [about.intro], Source={x:Static loc:Loc.Instance}}" />

                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding LearningSummary}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [about.section.limitations], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{Binding [about.limitations.rdp], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding [about.limitations.layouts], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding [about.limitations.code], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding [about.limitations.rare], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding [about.limitations.games], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [about.section.data], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding [about.dataFolder], Source={x:Static loc:Loc.Instance}}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DataFolderPath}"
                               Style="{DynamicResource HintTextStyle}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{Binding [about.openDataFolder], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="{Binding [about.openReadme], Source={x:Static loc:Loc.Instance}}"
                                Margin="10,0,0,0"
                                Style="{DynamicResource LinkButtonStyle}"
                                Command="{Binding OpenReadmeCommand}" />
                    </StackPanel>

                    <Border Style="{DynamicResource DividerStyle}" Margin="0,16,0,12" />

                    <TextBlock Text="{Binding [about.dictionaries], Source={x:Static loc:Loc.Instance}}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding LicensesText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="120"
                             MaxHeight="180"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
