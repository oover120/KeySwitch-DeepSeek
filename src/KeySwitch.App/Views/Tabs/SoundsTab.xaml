<UserControl x:Class="KeySwitch.App.Views.Tabs.SoundsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KeySwitch.App.Views.Controls"
             xmlns:loc="clr-namespace:KeySwitch.App.Localization"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="14"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel MaxWidth="760"
                    Margin="26,18,26,24"
                    HorizontalAlignment="Center">

            <TextBlock Text="{Binding [sounds.section], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [sounds.enabled.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [sounds.enabled.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding SoundsEnabled, Mode=TwoWay}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [sounds.switch.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [sounds.switch.description], Source={x:Static loc:Loc.Instance}}"
                                         IsEnabled="{Binding SoundsEnabled}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="250"
                                     Text="{Binding SwitchSoundPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding SwitchSoundPath}" />
                            <Button Content="{Binding [sounds.browse], Source={x:Static loc:Loc.Instance}}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseSwitchSoundCommand}" />
                            <Button Width="34"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    Command="{Binding PlaySwitchSoundCommand}"
                                    ToolTip="{Binding [sounds.preview], Source={x:Static loc:Loc.Instance}}">
                                <Path Data="M 0,0 L 7,5 L 0,10 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="7"
                                      Height="10"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [sounds.fix.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [sounds.fix.description], Source={x:Static loc:Loc.Instance}}"
                                         IsEnabled="{Binding SoundsEnabled}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="250"
                                     Text="{Binding FixSoundPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding FixSoundPath}" />
                            <Button Content="{Binding [sounds.browse], Source={x:Static loc:Loc.Instance}}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseFixSoundCommand}" />
                            <Button Width="34"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    Command="{Binding PlayFixSoundCommand}"
                                    ToolTip="{Binding [sounds.preview], Source={x:Static loc:Loc.Instance}}">
                                <Path Data="M 0,0 L 7,5 L 0,10 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="7"
                                      Height="10"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [sounds.volume.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [sounds.volume.description], Source={x:Static loc:Loc.Instance}}"
                                         IsEnabled="{Binding SoundsEnabled}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="220"
                                    Minimum="0"
                                    Maximum="1"
                                    SmallChange="0.05"
                                    LargeChange="0.1"
                                    Value="{Binding SoundVolume, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Width="52"
                                       Margin="10,0,0,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding SoundVolume, Converter={StaticResource Percent}}" />
                        </StackPanel>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock Style="{DynamicResource HintTextStyle}"
                       TextWrapping="Wrap"
                       Text="{Binding [sounds.hint], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
