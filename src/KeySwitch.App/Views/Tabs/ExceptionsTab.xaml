<UserControl x:Class="KeySwitch.App.Views.Tabs.ExceptionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KeySwitch.App.Localization"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="14"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel MaxWidth="760"
                    Margin="26,18,26,24"
                    HorizontalAlignment="Center">

            <TextBlock Text="{Binding [exceptions.section.processes], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,6" />
            <TextBlock Style="{DynamicResource HintTextStyle}"
                       Margin="2,0,0,10"
                       Text="{Binding [exceptions.processes.hint], Source={x:Static loc:Loc.Instance}}" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [exceptions.process.tooltip], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding Modes}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding NewProcessMode, Mode=TwoWay}" />
                        <Button Grid.Column="2"
                                Content="{Binding [exceptions.add], Source={x:Static loc:Loc.Instance}}"
                                Margin="8,0,0,0"
                                Command="{Binding AddProcessCommand}"
                                IsDefault="False" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{Binding [exceptions.browse], Source={x:Static loc:Loc.Instance}}"
                                HorizontalAlignment="Left"
                                Command="{Binding BrowseProcessCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProcessError}"
                                   Style="{DynamicResource DangerTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasProcessError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <Border Style="{DynamicResource DividerStyle}" Margin="0,12,0,6" />

                    <TextBlock Text="{Binding [exceptions.processes.empty], Source={x:Static loc:Loc.Instance}}"
                               Margin="2,8,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Processes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox x:Name="ProcessList"
                             ItemsSource="{Binding Processes}"
                             MaxHeight="230"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.Modes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Mode, Mode=TwoWay}" />
                                    <Button Grid.Column="2"
                                            Content="{Binding [exceptions.remove], Source={x:Static loc:Loc.Instance}}"
                                            Margin="10,0,0,0"
                                            Style="{DynamicResource LinkButtonStyle}"
                                            Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [exceptions.section.words], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,6" />
            <TextBlock Style="{DynamicResource HintTextStyle}"
                       Margin="2,0,0,10"
                       Text="{Binding [exceptions.words.hint], Source={x:Static loc:Loc.Instance}}" />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [exceptions.word.tooltip], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding Directions}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding NewWordDirection, Mode=TwoWay}" />
                        <Button Grid.Column="2"
                                Content="{Binding [exceptions.add], Source={x:Static loc:Loc.Instance}}"
                                Margin="8,0,0,0"
                                Command="{Binding AddWordCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding WordError}"
                               Style="{DynamicResource DangerTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasWordError, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{DynamicResource DividerStyle}" Margin="0,12,0,6" />

                    <ListBox ItemsSource="{Binding Words}"
                             MaxHeight="230"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Word}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentSubtleBrush}"
                                            Visibility="{Binding FromLearning, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding [exceptions.word.fromLearning], Source={x:Static loc:Loc.Instance}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              Margin="10,0,0,0"
                                              ItemsSource="{Binding DataContext.Directions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Direction, Mode=TwoWay}" />
                                    <Button Grid.Column="3"
                                            Content="{Binding [exceptions.remove], Source={x:Static loc:Loc.Instance}}"
                                            Margin="10,0,0,0"
                                            Style="{DynamicResource LinkButtonStyle}"
                                            Command="{Binding DataContext.RemoveWordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding [exceptions.words.empty], Source={x:Static loc:Loc.Instance}}"
                               Margin="2,8,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Words.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
