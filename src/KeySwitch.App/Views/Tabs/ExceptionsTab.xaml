<UserControl x:Class="KeySwitch.App.Views.Tabs.ExceptionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KeySwitch.App.ViewModels"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="14"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel MaxWidth="760"
                    Margin="26,18,26,24"
                    HorizontalAlignment="Center">

            <TextBlock Text="Программы" Style="{DynamicResource SectionTitleStyle}" Margin="2,0,0,6" />
            <TextBlock Style="{DynamicResource HintTextStyle}"
                       Margin="2,0,0,10"
                       Text="В приложениях из списка автопереключение ведёт себя по выбранному режиму: полная обработка, только ручная конвертация или полное отключение. Игры и папка Games отключаются глобально." />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Имя процесса или путь к exe: Code.exe" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0,0,0"
                                  ItemsSource="{x:Static vm:OptionLists.Modes}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding NewProcessMode, Mode=TwoWay}" />
                        <Button Grid.Column="2"
                                Content="Добавить"
                                Margin="8,0,0,0"
                                Command="{Binding AddProcessCommand}"
                                IsDefault="False" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Выбрать программу…"
                                HorizontalAlignment="Left"
                                Command="{Binding BrowseProcessCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProcessError}"
                                   Style="{DynamicResource DangerTextStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasProcessError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <Border Style="{DynamicResource DividerStyle}" Margin="0,12,0,6" />

                    <ListBox x:Name="ProcessList"
                             ItemsSource="{Binding Processes}"
                             MaxHeight="230"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{x:Static vm:OptionLists.Modes}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Mode, Mode=TwoWay}" />
                                    <Button Grid.Column="2"
                                            Content="Удалить"
                                            Margin="10,0,0,0"
                                            Style="{DynamicResource LinkButtonStyle}"
                                            Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Text="Слова-исключения" Style="{DynamicResource SectionTitleStyle}" Margin="2,0,0,6" />
            <TextBlock Style="{DynamicResource HintTextStyle}"
                       Margin="2,0,0,10"
                       Text="Эти слова никогда не переключаются автоматически — ни при наборе, ни при исправлении. Направление можно ограничить." />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Слово, которое нужно оставить как есть" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0,0,0"
                                  ItemsSource="{x:Static vm:OptionLists.Directions}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding NewWordDirection, Mode=TwoWay}" />
                        <Button Grid.Column="2"
                                Content="Добавить"
                                Margin="8,0,0,0"
                                Command="{Binding AddWordCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding WordError}"
                               Style="{DynamicResource DangerTextStyle}"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasWordError, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{DynamicResource DividerStyle}" Margin="0,12,0,6" />

                    <ListBox ItemsSource="{Binding Words}"
                             MaxHeight="230"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Word}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentSubtleBrush}"
                                            Visibility="{Binding FromLearning, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="из обучения"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              Margin="10,0,0,0"
                                              ItemsSource="{x:Static vm:OptionLists.Directions}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Direction, Mode=TwoWay}" />
                                    <Button Grid.Column="3"
                                            Content="Удалить"
                                            Margin="10,0,0,0"
                                            Style="{DynamicResource LinkButtonStyle}"
                                            Command="{Binding DataContext.RemoveWordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
