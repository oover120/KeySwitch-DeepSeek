<UserControl x:Class="KeySwitch.App.Views.Tabs.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KeySwitch.App.Views.Controls"
             xmlns:loc="clr-namespace:KeySwitch.App.Localization"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="14"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel MaxWidth="760"
                    Margin="26,18,26,24"
                    HorizontalAlignment="Center">

            <TextBlock Text="{Binding [general.section.behavior], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [general.enabled.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.enabled.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.autoswitch.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.autoswitch.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding AutoSwitch, Mode=TwoWay}"
                                      IsEnabled="{Binding Enabled}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [general.section.early], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [general.early.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.early.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding EarlySwitchEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding Enabled}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.earlyLength.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.earlyLength.description], Source={x:Static loc:Loc.Instance}}"
                                         IsEnabled="{Binding EarlySwitchEnabled}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="64"
                                     HorizontalContentAlignment="Center"
                                     Text="{Binding EarlySwitchMinLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{Binding [general.earlyLength.unit], Source={x:Static loc:Loc.Instance}}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [general.section.keys], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [general.singleShift.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.singleShift.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding SingleShiftSwitch, Mode=TwoWay}"
                                      IsEnabled="{Binding Enabled}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.doubleShift.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.doubleShift.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding DoubleShiftUndo, Mode=TwoWay}"
                                      IsEnabled="{Binding Enabled}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.hotkey.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.hotkey.description], Source={x:Static loc:Loc.Instance}}">
                        <controls:HotkeyBox Width="210"
                                            Value="{Binding ManualConvertHotkey, Mode=TwoWay}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.pause.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.pause.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding PauseHotkeyEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding Enabled}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [general.section.accuracy], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [general.confidence.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.confidence.description], Source={x:Static loc:Loc.Instance}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="240"
                                    Minimum="0.5"
                                    Maximum="5.0"
                                    SmallChange="0.1"
                                    LargeChange="0.5"
                                    Value="{Binding ConfidenceThreshold, Mode=TwoWay}" />
                            <TextBlock Width="44"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding ConfidenceThreshold, Converter={StaticResource NumberFormat}, ConverterParameter=0.0}" />
                        </StackPanel>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [general.section.startup], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [general.startup.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.startup.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.admin.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.admin.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding RunAsAdmin, Mode=TwoWay}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.safe.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.safe.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding SafeMode, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [general.section.appearance], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [general.theme.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.theme.description], Source={x:Static loc:Loc.Instance}}">
                        <ComboBox Width="220"
                                  ItemsSource="{Binding Themes}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ThemeValue, Mode=TwoWay}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [general.language.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [general.language.description], Source={x:Static loc:Loc.Instance}}">
                        <ComboBox Width="220"
                                  ItemsSource="{Binding Languages}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding LanguageValue, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
