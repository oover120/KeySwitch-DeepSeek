<UserControl x:Class="KeySwitch.App.Views.Tabs.TyposTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KeySwitch.App.Views.Controls"
             xmlns:loc="clr-namespace:KeySwitch.App.Localization"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="14"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel MaxWidth="760"
                    Margin="26,18,26,24"
                    HorizontalAlignment="Center">

            <TextBlock Text="{Binding [typos.section.correction], Source={x:Static loc:Loc.Instance}}"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="2,0,0,10" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SettingRow Header="{Binding [typos.enabled.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [typos.enabled.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding TyposEnabled, Mode=TwoWay}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [typos.caps.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [typos.caps.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding CapsFixEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding TyposEnabled}" />
                    </controls:SettingRow>

                    <Border Style="{DynamicResource DividerStyle}" />

                    <controls:SettingRow Header="{Binding [typos.yo.header], Source={x:Static loc:Loc.Instance}}"
                                         Description="{Binding [typos.yo.description], Source={x:Static loc:Loc.Instance}}">
                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding YoFixEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding TyposEnabled}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <Grid Margin="2,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding [typos.dictionary], Source={x:Static loc:Loc.Instance}}"
                           Style="{DynamicResource SectionTitleStyle}" />
                <ComboBox Grid.Column="1"
                          Width="180"
                          ItemsSource="{Binding TypoLanguages}"
                          DisplayMemberPath="Title"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedTypoLanguage, Mode=TwoWay}" />
            </Grid>

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource HintTextStyle}"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="{Binding [typos.hint], Source={x:Static loc:Loc.Instance}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewTypoWrong, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [typos.wrong.tooltip], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Grid.Column="1"
                                   Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding NewTypoRight, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [typos.right.tooltip], Source={x:Static loc:Loc.Instance}}" />
                        <Button Grid.Column="3"
                                Content="{Binding [action.add], Source={x:Static loc:Loc.Instance}}"
                                Margin="8,0,0,0"
                                Command="{Binding AddTypoCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding TypoError}"
                               Style="{DynamicResource DangerTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding TypoError, Converter={StaticResource EmptyStringToVisibility}}" />

                    <Border Style="{DynamicResource DividerStyle}" Margin="0,12,0,6" />

                    <ListBox ItemsSource="{Binding TypoView}"
                             MaxHeight="250"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Wrong}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="→"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Right, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="3"
                                            Content="{Binding [action.remove], Source={x:Static loc:Loc.Instance}}"
                                            Margin="10,0,0,0"
                                            Style="{DynamicResource LinkButtonStyle}"
                                            Command="{Binding DataContext.RemoveTypoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding [typos.empty], Source={x:Static loc:Loc.Instance}}"
                               Margin="2,8,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypoView.IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding TyposFilesText}"
                               Style="{DynamicResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
